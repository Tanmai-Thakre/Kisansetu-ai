# ─────────────────────────────────────────────────────────
# KisanSetu AI — Environment Variables
# Phase 2: Market Intelligence & Mandi Price System
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control.
# ─────────────────────────────────────────────────────────

# ── Market Data Provider ──────────────────────────────────
# Set to "live" to switch from demo data to real market API (Phase 3)
MARKET_DATA_PROVIDER=demo
# MARKET_API_KEY=your-agmarknet-or-enam-api-key
# MARKET_API_URL=https://api.data.gov.in/resource/...

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://kisansetu:kisansetu@localhost:5432/kisansetu_db
POSTGRES_USER=kisansetu
POSTGRES_PASSWORD=kisansetu
POSTGRES_DB=kisansetu_db

# ── API Security ──────────────────────────────────────────
SECRET_KEY=replace-with-a-strong-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────
# IBM Cloud Credentials (Phase 2)
# ─────────────────────────────────────────────────────────
IBM_CLOUD_API_KEY=your-ibm-cloud-api-key-here
IBM_CLOUD_REGION=us-south

# ── IBM watsonx.ai / Granite ──────────────────────────────
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your-watsonx-project-id-here
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# ── IBM Db2 (optional, if migrating from PostgreSQL) ──────
# IBM_DB2_HOST=
# IBM_DB2_PORT=50000
# IBM_DB2_DATABASE=
# IBM_DB2_USER=
# IBM_DB2_PASSWORD=

# ─────────────────────────────────────────────────────────
# Real Market Data APIs (Phase 3)
# ─────────────────────────────────────────────────────────
# AGMARKNET_API_KEY=your-agmarknet-api-key
# ENAM_API_KEY=your-enam-api-key
# COMMODITY_PRICE_API_KEY=your-commodity-api-key
