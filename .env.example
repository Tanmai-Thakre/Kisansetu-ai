# ═══════════════════════════════════════════════════════════════════════════
# KisanSetu AI — Environment Variables
# Phase 10: Final Deployment Configuration
#
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# Production: PostgreSQL on IBM Cloud Databases or RDS
DATABASE_URL=postgresql://kisansetu:kisansetu@localhost:5432/kisansetu_db

# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=kisansetu
POSTGRES_PASSWORD=kisansetu
POSTGRES_DB=kisansetu_db

# Local development fallback — SQLite (no PostgreSQL needed)
# DATABASE_URL=sqlite:///./kisansetu_dev.db

# ── IBM Granite / watsonx.ai ──────────────────────────────────────────────────
# Obtain from: https://cloud.ibm.com → watsonx.ai → Projects
# All four variables required for Granite to work.
# Without these, the app runs in deterministic fallback mode.
IBM_API_KEY=your-ibm-cloud-api-key-here
IBM_PROJECT_ID=your-watsonx-project-id-here
IBM_GRANITE_MODEL=ibm/granite-3-8b-instruct
IBM_REGION=us-south

# Alternative/legacy variable names (also accepted):
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_PROJECT_ID=your-watsonx-project-id-here
# WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
# IBM_CLOUD_API_KEY=your-ibm-cloud-api-key-here
# IBM_CLOUD_REGION=us-south

# ── API Security ──────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-strong-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ─────────────────────────────────────────────────────────────────────
# Production: set to your actual frontend domain
# Multiple origins: comma-separated, no spaces
CORS_ORIGINS=http://localhost:3000

# Production example:
# CORS_ORIGINS=https://kisansetu.yourdomain.com,http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
# Used by Next.js at BUILD TIME (baked into JS bundle)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production:
# NEXT_PUBLIC_API_URL=https://api.kisansetu.yourdomain.com

# ── Market Data Provider ──────────────────────────────────────────────────────
# "demo"  → use built-in synthetic data (default, no external API needed)
# "live"  → use real AgMarkNet/eNAM API (requires MARKET_API_KEY)
MARKET_DATA_PROVIDER=demo

# If using live data:
# MARKET_API_KEY=your-agmarknet-or-enam-api-key
# MARKET_API_URL=https://api.data.gov.in/resource/...

# ── Quality Image Uploads ─────────────────────────────────────────────────────
QUALITY_UPLOAD_DIR=./uploads/quality
# Max upload size is enforced in code: 10 MB

# ── IBM Cloud (optional — for Cloud Foundry / Code Engine deployment) ─────────
# IBM_CLOUD_API_KEY=your-ibm-cloud-api-key-here
# IBM_CLOUD_REGION=us-south
# IBM_CODE_ENGINE_APP_URL=https://your-app.us-south.codeengine.appdomain.cloud
