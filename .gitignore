# ─────────────────────────────────────────────
# KisanSetu AI — .gitignore
# ─────────────────────────────────────────────

# ── Environment / Secrets ─────────────────────
.env
.env.local
.env.*.local
*.env

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
wheels/

# Development/validation scripts (internal use only)
validate_phase*.py

# pytest / test artifacts
.pytest_cache/
.coverage
htmlcov/
*.coveragerc
coverage.xml
nosetests.xml
pytest.ini
*.log

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# ── Database files ────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Uploaded user files ───────────────────────
backend/uploads/**
!backend/uploads/.gitkeep

# ── Node.js / Next.js ─────────────────────────
node_modules/
.next/
out/
.nuxt/
dist/

# Next.js build artifacts
frontend/.next/
frontend/out/

# TypeScript build info
*.tsbuildinfo
tsconfig.tsbuildinfo

# npm/yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS / Editor ───────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Docker ────────────────────────────────────
# (docker-compose.yml is intentionally committed)